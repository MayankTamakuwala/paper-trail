MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=paper_trail
PORT=3000

# Not a credential. OpenAlex is a free open API with no key.
# Sending a contact address puts requests in their faster polite pool.
OPENALEX_CONTACT=you@example.com
SEED_TARGET=1200