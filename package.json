  "description": "A reading queue for the research papers you meant to read",
  "type": "module",
  "license": "MIT",
  "author": "Mayank Tamakuwala",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file=.env server/local.js",
